guiTypes = {
	# A compact, recessed treasury readout occupies the gap opened between the
	# convoy counter and the shifted command/experience block. It mirrors the
	# native stability and war-support indicators and opens the economy window.
	containerWindowType = {
		name = "ADISCORD_economy_treasury_topbar_window"
		position = { x = 708 y = 5 }
		Orientation = UPPER_LEFT
		size = { width = 73 height = 28 }
		clipping = no

		buttonType = {
			name = "ADISCORD_economy_treasury_topbar_open"
			quadTextureSprite = "GFX_generic_box_smallest"
			position = { x = 0 y = 0 }
			size = { x = 73 y = 28 }
			clicksound = click_default
			pdx_tooltip = "ADISCORD_economy_topbar_treasury_tooltip"
		}

		iconType = {
			name = "ADISCORD_economy_treasury_topbar_icon"
			spriteType = "GFX_ADISCORD_treasury_icon"
			position = { x = 2 y = 2 }
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = "ADISCORD_economy_treasury_topbar_value"
			position = { x = 25 y = 4 }
			font = "hoi_18mbs"
			text = "ADISCORD_economy_topbar_treasury_value"
			format = center
			maxWidth = 46
			maxHeight = 24
			fixedsize = yes
			alwaystransparent = yes
			pdx_tooltip = "ADISCORD_economy_topbar_treasury_tooltip"
		}
	}

	containerWindowType = {
		name = "ADISCORD_economy_topbar_window"
		# The top_bar token is reliable; these coordinates mirror the reserved
		# slot immediately to the right of Trade in interface/topbar.gui.
		position = { x = 405 y = 36 }
		Orientation = UPPER_LEFT
		size = { width = 55 height = 41 }
		clipping = no

		buttonType = {
			name = "ADISCORD_economy_topbar_button"
			quadTextureSprite = "GFX_ADISCORD_economy_topbar_button"
			position = { x = 0 y = 0 }
			size = { x = 55 y = 41 }
			clicksound = click_default
			pdx_tooltip = "ADISCORD_economy_topbar_treasury_tooltip"
		}
	}

	# One registered scripted-GUI window owns the shell and all content. Keeping
	# the panels nested prevents click_to_front from hiding a separate page.
