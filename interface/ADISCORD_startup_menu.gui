		# Long pages scroll as a container: an expanding textbox reports its
		# rendered height, while a textbox slider can clip text without moving.
		# The transparent background is the wheel hit area between lines.
		# Hide the outer panel so the viewport's native scrollbar hides with it.
		containerWindowType = {
			name = "ADISCORD_startup_country_panel"
			position = { x = 34 y = 138 }
			size = { width = 695 height = 407 }
			containerWindowType = {
				name = "ADISCORD_startup_country_scroll"
				position = { x = 0 y = 0 }
				size = { width = 695 height = 407 }
				clipping = yes
				verticalScrollbar = "right_vertical_slider"
				scroll_wheel_factor = 40
				smooth_scrolling = yes
				background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }
				instantTextboxType = {
					name = "ADISCORD_startup_country_body"
					position = { x = 0 y = 0 }
					font = "hoi_18mbs"
					text = "[ADISCORDGetStartupBody]"
					maxWidth = 675
					maxHeight = 2400
					format = left
				}
			}
		}
