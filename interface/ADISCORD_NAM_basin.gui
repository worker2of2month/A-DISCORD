guiTypes = {
	# Launcher row inside the NAM_national_programmes decision category.
	containerWindowType = {
		name = "ADISCORD_NAM_basin_launcher_window"
		position = { x = 0 y = 0 }
		size = { width = 460 height = 46 }

		buttonType = {
			name = "NAM_bw_open_button"
			position = { x = 8 y = 5 }
			quadTextureSprite = "GFX_button_221x34"
			buttonText = "NAM_bw_open"
			buttonFont = "hoi_16mbs"
			clicksound = click_default
			pdx_tooltip = "NAM_bw_open_tt"
		}
		instantTextBoxType = {
			name = "NAM_bw_launcher_summary"
			position = { x = 238 y = 5 }
			text = "NAM_bw_launcher_summary"
			font = "hoi_16mbs"
			maxWidth = 214
			maxHeight = 36
			fixedsize = yes
			pdx_tooltip = "NAM_bw_open_tt"
		}
	}

	# Basin window. Six node cards share one inner layout: name, four status
	# lines and up to three actions on the right. Card element names carry the
	# state ID because the scripted GUI binds triggers and effects by name.
