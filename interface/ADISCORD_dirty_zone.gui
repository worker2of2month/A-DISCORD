guiTypes = {
	# The Exclusion Zone replaces the selected-country page with a deliberately
	# non-interactive quarantine dossier. Only the engine-owned diplomacy title
	# bar and close button remain outside this full-size quarantine layer.
	containerWindowType = {
		name = "ADISCORD_Dirty_Zone_Diplomacy_Container"
		position = { x = 0 y = 0 }
		size = { width = 680 height = 100%% }
