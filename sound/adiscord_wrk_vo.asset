# Esperanto infantry voices for WRK.
# Attack acknowledgements share the combat pool: the engine has no separate attack-order voice hook.
category = {
	name = "Voices"
	soundeffects = {
		WRK_infantry_idle
		WRK_infantry_move_out
		WRK_infantry_neutral_combat
		WRK_infantry_positive_combat
		WRK_infantry_retreat
	}
	compressor = {
		enabled = yes
		pregain = 0.0
		postgain = 2.0
		ratio = 10.0
		threshold = -10.0
		attacktime = 0.030
		releasetime = 1.2
	}
}

