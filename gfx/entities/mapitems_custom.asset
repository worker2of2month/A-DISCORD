}

entity = {
	name = "ADISCORD_unity_tower_collapse_entity"
	pdxmesh = "ADISCORD_unity_tower_destruction_mesh"
	locator = { name = "core_blast" position = { 7 13 -5 } }
	locator = { name = "west_blast" position = { 2 10 -8 } }
	locator = { name = "east_blast" position = { 13 10 -5 } }
	locator = { name = "front_impact" position = { 8 7 -13 } }
	locator = { name = "rear_impact" position = { 10 8 0 } }
	locator = { name = "ruin_smoke" position = { 8 8 -5 } }
	default_state = "collapse"
	state = {
		name = "collapse"
		animation = "collapse"
		animation_blend_time = 0
		animation_speed = 0.5
		looping = no
		next_state = "ruins"
		event = { time = 0 node = "core_blast" particle = "explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0.55 node = "core_blast" particle = "building_explode_effect" keep_particle = yes trigger_once = yes }
		event = { time = 1.1 node = "west_blast" particle = "explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 1.6 node = "east_blast" particle = "explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 2 node = "west_blast" particle = "city_fire_particle" trigger_once = yes }
		event = { time = 2.7 node = "east_blast" particle = "city_fire_particle" trigger_once = yes }
		event = { time = 3.2 node = "front_impact" particle = "building_explode_effect" keep_particle = yes trigger_once = yes }
		event = { time = 3.8 node = "rear_impact" particle = "building_explode_effect" keep_particle = yes trigger_once = yes }
		event = { time = 5 node = "ruin_smoke" particle = "bunker_smoke_effect" keep_particle = yes trigger_once = yes }
	}
	state = {
		name = "ruins"
		animation = "ruins"
		animation_blend_time = 0
		looping = no
	}
}

