entity = {
	name = "ADISCORD_vorkerland_pyramid_entity"
	pdxmesh = "ADISCORD_vorkerland_pyramid_mesh"

	locator = { name = "smog_particle_1" position = { 0.0 5.0 0.0 } }
	# Preserve A-Discord's denser seven-point city-smoke composition on the
	# Vorkerland pyramid only instead of overriding vanilla city_smoke_entity.
	locator = { name = "ADISCORD_city_smoke_1" position = { 1.0 0.1 -1.8 } }
	locator = { name = "ADISCORD_city_smoke_2" position = { 0.1 0.0 0.0 } }
	locator = { name = "ADISCORD_city_smoke_3" position = { -2.0 0.0 1.5 } }
	locator = { name = "ADISCORD_city_smoke_4" position = { 3.0 0.0 1.0 } }
	locator = { name = "ADISCORD_city_smoke_5" position = { -1.5 0.0 0.5 } }
	locator = { name = "ADISCORD_city_smoke_6" position = { 2.0 0.0 -0.5 } }
	locator = { name = "ADISCORD_city_smoke_7" position = { 0.0 0.0 1.0 } }

	default_state = "idle"
	state = { name = "idle"
		event = { 
			time = 0.0 node="smog_particle_1"   
			particle = "smog_particle"
		}
		event = { time = 0 node = "ADISCORD_city_smoke_1" particle = "city_smoke_particle" keep_particle = yes }
		event = { time = 0 node = "ADISCORD_city_smoke_2" particle = "city_smoke_l_particle" keep_particle = yes }
		event = { time = 0 node = "ADISCORD_city_smoke_3" particle = "city_smoke_particle" keep_particle = yes }
		event = { time = 0 node = "ADISCORD_city_smoke_4" particle = "city_smoke_s_particle" keep_particle = yes }
		event = { time = 0 node = "ADISCORD_city_smoke_5" particle = "city_smoke_l_particle" keep_particle = yes }
		event = { time = 0 node = "ADISCORD_city_smoke_6" particle = "city_smoke_s_particle" keep_particle = yes }
		event = { time = 0 node = "ADISCORD_city_smoke_7" particle = "city_smoke_particle" keep_particle = yes }
	}
}

# Same Vorkerland landmark mesh without the pre-reveal smog/city-smoke emitters.
# Reusing actor id 610040 swaps only the visual state and keeps the landmark in place.
entity = {
	name = "ADISCORD_vorkerland_pyramid_clear_entity"
	pdxmesh = "ADISCORD_vorkerland_pyramid_mesh"
	default_state = "idle"
	state = { name = "idle" }
}

entity = {
	name = "ADISCORD_unity_tower_collapse_entity"
	pdxmesh = "ADISCORD_unity_tower_destruction_mesh"
	locator = { name = "core_blast" position = { 7 13 -5 } }
	locator = { name = "west_blast" position = { 2 10 -8 } }
	locator = { name = "east_blast" position = { 13 10 -5 } }
	locator = { name = "front_impact" position = { 8 7 -13 } }
	locator = { name = "rear_impact" position = { 10 8 0 } }
	locator = { name = "ruin_smoke" position = { 8 8 -5 } }
	default_state = "collapse"
	state = {
		name = "collapse"
		animation = "collapse"
		animation_blend_time = 0
		animation_speed = 1
		looping = no
		next_state = "ruins"
		event = { time = 0 node = "core_blast" particle = "explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0.55 node = "core_blast" particle = "building_explode_effect" keep_particle = yes trigger_once = yes }
		event = { time = 1.1 node = "west_blast" particle = "explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 1.6 node = "east_blast" particle = "explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 2 node = "west_blast" particle = "city_fire_particle" trigger_once = yes }
		event = { time = 2.7 node = "east_blast" particle = "city_fire_particle" trigger_once = yes }
		event = { time = 3.2 node = "front_impact" particle = "building_explode_effect" keep_particle = yes trigger_once = yes }
		event = { time = 3.8 node = "rear_impact" particle = "building_explode_effect" keep_particle = yes trigger_once = yes }
		event = { time = 5 node = "ruin_smoke" particle = "bunker_smoke_effect" keep_particle = yes trigger_once = yes }
	}
	state = {
		name = "ruins"
		animation = "ruins"
		animation_blend_time = 0
		looping = no
	}
}

entity = {
	clone = "ADISCORD_unity_tower_collapse_entity"
	name = "ADISCORD_unity_tower_ruins_entity"
	default_state = "ruins"
}

