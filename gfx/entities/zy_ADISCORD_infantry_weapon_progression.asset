# Loaded after units_infantry.asset and before country infantry entities.
# Wrappers retain native transforms and firing events. Explicit bind-pose
# clips initialize the skinned weapons in idle and move states.

entity = {
	clone = "BEL_infantry_weapon_rifle_right_entity"
	name = "ADISCORD_infantry_weapon_0_right_entity"
	pdxmesh = "ADISCORD_infantry_weapon_0_mesh"
	default_state = "idle"
	state = { name = "idle" animation = "idle" }
	state = { name = "move" animation = "idle" }
}
entity = {
	clone = "BEL_infantry_weapon_rifle_left_entity"
	name = "ADISCORD_infantry_weapon_0_left_entity"
	pdxmesh = "ADISCORD_infantry_weapon_0_mesh"
	default_state = "idle"
	state = { name = "idle" animation = "idle" }
	state = { name = "move" animation = "idle" }
	state = {
	name = "defend" animation = "support_attack"
	event = { time = 0 node="muzzle" particle = "rifle_muzzle_particle"  keep_particle = yes light = "muzzle_flash" sound = { soundeffect = infantry_rifle_attack } }
	event = { time = 1.2 node="cartridge" particle = "rifle_cartridge_particle"  keep_particle = yes sound = { soundeffect = infantry_rifle_cartridge } }
	}
}
