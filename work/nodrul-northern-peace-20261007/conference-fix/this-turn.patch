+        fixture.execute(block(block(hooks, "on_uncapitulation"), "effect"), ["YPR"])
+        self.defeat(fixture, "COF")
+        self.defeat(fixture, "TFF")
+        self.assertNotIn("YPR", fixture.subjects)
