      "check_command": ["{python}", "-B", "-m", "tools.builders.build_adiscord_ainholm_mandate"],
      "apply_command": ["{python}", "-B", "-m", "tools.builders.build_adiscord_ainholm_mandate", "--apply"],
      "may_delete_outputs": false,
      "ownership_mode": "layered",
      "overlap_explanation": "Ainholm owns metadata inside state history and flag directories shared with the state and regional country pipelines."
